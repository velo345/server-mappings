{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Velo Client server mapping",
  "type": "object",
  "required": ["id", "name", "addresses"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$", "description": "Same as the folder name." },
    "name": { "type": "string", "minLength": 2, "maxLength": 40 },
    "description": { "type": "string", "maxLength": 160 },
    "addresses": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "pattern": "^(\\*\\.)?[a-z0-9-]+(\\.[a-z0-9-]+)+(:[0-9]{1,5})?$" }, "description": "Every address players join with. *.example.com covers all subdomains." },
    "primaryAddress": { "type": "string" },
    "website": { "type": "string", "pattern": "^https://" },
    "discord": { "type": "string", "pattern": "^https://(discord\\.gg|discord\\.com/invite)/" },
    "store": { "type": "string", "pattern": "^https://" },
    "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "gameTypes": { "type": "array", "items": { "type": "string", "enum": ["smp", "pvp", "minigames", "skyblock", "survival", "factions", "prison", "creative", "hardcore", "anarchy", "roleplay", "modded", "lifesteal", "practice", "bedwars", "events", "other"] } },
    "regions": { "type": "array", "items": { "type": "string", "enum": ["NA", "EU", "SA", "AS", "OC", "AF"] } },
    "minecraftVersions": { "type": "object", "additionalProperties": false, "properties": { "min": { "type": "string" }, "max": { "type": "string" }, "recommended": { "type": "string" } } },
    "presence": {
      "type": "object",
      "additionalProperties": false,
      "description": "Discord Rich Presence for Velo players on your server. %name% = server name. Servers with the Velo Bridge plugin can also set this live.",
      "properties": {
        "details": { "type": "string", "maxLength": 100 },
        "state": { "type": "string", "maxLength": 100 },
        "largeImageText": { "type": "string", "maxLength": 100 },
        "buttons": { "type": "array", "maxItems": 2, "items": { "type": "object", "required": ["label", "url"], "additionalProperties": false, "properties": { "label": { "type": "string", "maxLength": 32 }, "url": { "type": "string", "pattern": "^https://" } } } }
      }
    }
  }
}
